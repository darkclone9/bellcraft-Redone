#!/usr/bin/env python3
"""bellcraft-deploy: the only thing the GitHub deploy key can run on the Bellcraft box.

The key's authorized_keys entry forces `sudo -n /usr/local/sbin/bellcraft-deploy`; the requested
action arrives in SSH_ORIGINAL_COMMAND (or argv when run by hand):

  export [server ...]   stream the tracked, redacted config as a tar (see bellcraft-export)
  apply <server>        read a tar from stdin and install it into /opt/bellcraft/<server>
  status                one line per server: running or not

`apply` is deliberately narrow:
  * only text config under config/, plugins/ and world/datapacks/, plus bukkit/spigot/commands/help/
    permissions yml and velocity.toml. Never jars, server.properties, start.sh or world data.
  * a file still holding <<REDACTED>> is refused - redacted files are edited on the server only.
  * unchanged files are skipped; every overwritten or deleted file is backed up first to
    /opt/bellcraft/_backups/deploy/<timestamp>/<server>/...
  * files are installed owned by minecraft (root-owned files break plugins that save their config).
  * changed Skript scripts are `sk reload`ed over RCON; anything else is reported as needing a
    plugin reload or a restart - this tool never restarts a server.
Deletions travel as servers/<server>/.deploy-delete, one repo-relative path per line.
"""
import datetime, fcntl, io, json, os, re, shlex, shutil, socket, struct, subprocess, sys, tarfile

ROOT = '/opt/bellcraft'
SERVERS = ['proxy', 'lobby', 'survival', 'creative', 'classic', 'rpg', 'test']
UNITS = {s: f'bellcraft-{s}' for s in SERVERS}
TOP_OK = {'bukkit.yml', 'spigot.yml', 'commands.yml', 'help.yml', 'permissions.yml', 'velocity.toml', 'wepif.yml'}
TREE_OK = ('config/', 'plugins/', 'world/datapacks/')
EXTS = {'.yml', '.yaml', '.toml', '.json', '.sk', '.conf', '.properties', '.mcfunction', '.mcmeta', '.txt', '.md'}
MARK = b'<<REDACTED>>'
MAX_TAR = 64 * 1024 * 1024
LOG = '/var/log/bellcraft-deploy.log'
EXPORT = '/usr/local/sbin/bellcraft-export'


def log(msg):
    line = f'{datetime.datetime.now(datetime.timezone.utc):%Y-%m-%dT%H:%M:%SZ} {msg}'
    print(msg, flush=True)
    try:
        with open(LOG, 'a') as f:
            f.write(line + '\n')
    except OSError:
        pass


def allowed(rel):
    if rel.startswith('/') or '\\' in rel or any(p in ('', '.', '..') for p in rel.split('/')):
        return False
    if rel in TOP_OK:
        return True
    return rel.startswith(TREE_OK) and os.path.splitext(rel)[1].lower() in EXTS


def rcon(server, command):
    props = {}
    try:
        for line in open(os.path.join(ROOT, server, 'server.properties')):
            if '=' in line:
                k, v = line.rstrip('\n').split('=', 1)
                props[k] = v
    except OSError:
        return None
    if props.get('enable-rcon') != 'true':
        return None
    def pack(i, t, body):
        p = struct.pack('<ii', i, t) + body.encode() + b'\0\0'
        return struct.pack('<i', len(p)) + p
    def read(s):
        n = struct.unpack('<i', s.recv(4))[0]
        buf = b''
        while len(buf) < n:
            buf += s.recv(n - len(buf))
        return struct.unpack('<ii', buf[:8])[0], buf[8:-2].decode('utf-8', 'replace')
    try:
        with socket.create_connection(('127.0.0.1', int(props.get('rcon.port', 0))), timeout=10) as s:
            s.sendall(pack(1, 3, props.get('rcon.password', '')))
            if read(s)[0] == -1:
                return None
            s.sendall(pack(2, 2, command))
            return re.sub('§.', '', read(s)[1])
    except (OSError, struct.error, ValueError):
        return None


def running(server):
    return subprocess.run(['systemctl', 'is-active', '--quiet', UNITS[server]]).returncode == 0


def with_geyser_format_version(rel, content):
    if not (rel.startswith('plugins/Geyser-') and rel.endswith('/custom_mappings/bellcraft_radio_sounds.json')):
        return content, None
    try:
        data = json.loads(content.decode('utf-8'))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return content, None
    if not isinstance(data, dict) or 'format_version' in data:
        return content, None
    if 'items' in data:
        version = 2
    elif 'blocks' in data:
        version = 1
    else:
        version = 1
    updated = {'format_version': version}
    updated.update(data)
    return json.dumps(updated, ensure_ascii=False, separators=(',', ':')).encode('utf-8'), version


def apply(server):
    data = sys.stdin.buffer.read(MAX_TAR + 1)
    if len(data) > MAX_TAR:
        sys.exit('refused: upload larger than 64 MB')
    base = os.path.join(ROOT, server)
    prefix = f'servers/{server}/'
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    backup = os.path.join(ROOT, '_backups', 'deploy', stamp, server)
    changed, same, refused, deleted = [], 0, [], []

    def backup_file(rel):
        src = os.path.join(base, rel)
        if os.path.isfile(src):
            dst = os.path.join(backup, rel)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copy2(src, dst)

    def install(rel, content):
        dst = os.path.join(base, rel)
        d = os.path.dirname(dst)
        if not os.path.isdir(d):
            subprocess.run(['install', '-d', '-o', 'minecraft', '-g', 'minecraft', '-m', '755', d], check=True)
        tmp = dst + '.deploy-tmp'
        with open(tmp, 'wb') as f:
            f.write(content)
        shutil.chown(tmp, 'minecraft', 'minecraft')
        os.chmod(tmp, 0o644)
        os.replace(tmp, dst)

    deletes = []
    with tarfile.open(fileobj=io.BytesIO(data), mode='r:*') as tar:
        for m in tar:
            if m.isdir():
                continue
            if not m.name.startswith(prefix):
                refused.append(f'{m.name} (outside {prefix})')
                continue
            rel = m.name[len(prefix):]
            if rel == '.deploy-delete' and m.isfile():
                deletes = [l.strip() for l in tar.extractfile(m).read().decode().splitlines() if l.strip()]
                continue
            if not m.isfile():
                refused.append(f'{rel} (not a regular file)')
                continue
            if not allowed(rel):
                refused.append(f'{rel} (not a deployable path)')
                continue
            content = tar.extractfile(m).read()
            if MARK in content:
                refused.append(f'{rel} (contains <<REDACTED>> - edit it on the server)')
                continue
            content, version = with_geyser_format_version(rel, content)
            if version is not None:
                log(f'  normalized {rel}: added format_version={version}')
            dst = os.path.join(base, rel)
            if os.path.isfile(dst) and open(dst, 'rb').read() == content:
                same += 1
                continue
            backup_file(rel)
            install(rel, content)
            changed.append(rel)

    for rel in deletes:
        dst = os.path.join(base, rel)
        if not allowed(rel):
            refused.append(f'delete {rel} (not a deployable path)')
        elif os.path.isfile(dst):
            backup_file(rel)
            os.remove(dst)
            deleted.append(rel)

    log(f'apply {server}: {len(changed)} changed, {len(deleted)} deleted, {same} unchanged, {len(refused)} refused'
        + (f', backup {backup}' if changed or deleted else ''))
    for r in changed:
        log(f'  + {r}')
    for r in deleted:
        log(f'  - {r}')
    for r in refused:
        log(f'  ! refused {r}')

    touched = changed + deleted
    scripts = sorted({os.path.basename(r) for r in touched
                      if r.startswith('plugins/Skript/scripts/') and r.endswith('.sk')})
    others = sorted({'/'.join(r.split('/')[:2]) for r in touched if not r.startswith('plugins/Skript/scripts/')})
    if scripts:
        if server != 'proxy' and running(server):
            for sk in scripts:
                reply = rcon(server, f'sk reload {sk[:-3]}')
                log(f'  sk reload {sk}: ' + ((reply or 'no RCON reply').strip().replace('\n', ' ')[:200]))
            log('  NOTE: Skript only prints parse errors at boot. If a script misbehaves, restart and read the log.')
        else:
            log(f'  {server} is not running; scripts load on next start')
    if others:
        log('  Needs a plugin reload or a restart to take effect: ' + ', '.join(others))
    if refused:
        sys.exit(2)


def main():
    cmd = os.environ.get('SSH_ORIGINAL_COMMAND')
    args = shlex.split(cmd) if cmd else sys.argv[1:]
    if not args:
        sys.exit('usage: export [server ...] | apply <server> | status')
    action, rest = args[0], args[1:]
    if action == 'export':
        if any(s not in SERVERS for s in rest):
            sys.exit('unknown server')
        os.execv('/usr/bin/python3', ['python3', EXPORT] + rest)
    if action == 'status':
        for s in SERVERS:
            print(f'{s:10} {"running" if running(s) else "stopped"}')
        return
    if action == 'apply' and len(rest) == 1 and rest[0] in SERVERS:
        with open('/run/bellcraft-deploy.lock', 'w') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            apply(rest[0])
        return
    sys.exit(f'refused: {" ".join(args)[:100]}')


if __name__ == '__main__':
    main()
