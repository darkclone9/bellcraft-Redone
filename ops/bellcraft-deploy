#!/usr/bin/env python3
"""bellcraft-deploy: the only thing the GitHub deploy key can run on the Bellcraft box.

The key's authorized_keys entry forces `sudo -n /usr/local/sbin/bellcraft-deploy`; the requested
action arrives in SSH_ORIGINAL_COMMAND (or argv when run by hand):

  export [server ...]   stream the tracked, redacted config as a tar (see bellcraft-export)
  apply <server>        read a tar from stdin and install it into /opt/bellcraft/<server>
  status                one line per server: running or not

`apply` is deliberately narrow:
  * only text config under config/, plugins/ and world/datapacks/, plus bukkit/spigot/commands/help/
    permissions yml and velocity.toml. Never jars, server.properties, start.sh or world data.
  * a file still holding <<REDACTED>> is refused - redacted files are edited on the server only.
  * unchanged files are not rewritten; every overwritten or deleted file is backed up first to
    /opt/bellcraft/_backups/deploy/<timestamp>/<server>/...
  * every server is treated the same. Each installed file is left owned by minecraft:minecraft,
    and so is every directory from /opt/bellcraft/<server> down to that file. Unchanged files are
    not rewritten, but their ownership is repaired. Root-owned files or directories break plugins
    that save their own config (they cannot write the file, or a temp file next to it).
  * changed Skript scripts are `sk reload`ed over RCON; anything else is reported as needing a
    plugin reload or a restart - this tool never restarts a server.
Deletions travel as servers/<server>/.deploy-delete, one repo-relative path per line.
"""
import datetime, fcntl, grp, io, json, os, pwd, re, shlex, shutil, socket, stat, struct, subprocess, sys, tarfile

ROOT = '/opt/bellcraft'
SERVERS = ['proxy', 'lobby', 'survival', 'creative', 'classic', 'rpg', 'test']
UNITS = {s: f'bellcraft-{s}' for s in SERVERS}
TOP_OK = {'bukkit.yml', 'spigot.yml', 'commands.yml', 'help.yml', 'permissions.yml', 'velocity.toml', 'wepif.yml'}
TREE_OK = ('config/', 'plugins/', 'world/datapacks/')
EXTS = {'.yml', '.yaml', '.toml', '.json', '.sk', '.conf', '.properties', '.mcfunction', '.mcmeta', '.txt', '.md'}
MARK = b'<<REDACTED>>'
MAX_TAR = 64 * 1024 * 1024
LOG = '/var/log/bellcraft-deploy.log'
EXPORT = '/usr/local/sbin/bellcraft-export'


class Refused(Exception):
    """A single path cannot be installed. apply() records these and exits 2 after the summary."""


def log(msg):
    line = f'{datetime.datetime.now(datetime.timezone.utc):%Y-%m-%dT%H:%M:%SZ} {msg}'
    print(msg, flush=True)
    try:
        with open(LOG, 'a') as f:
            f.write(line + '\n')
    except OSError:
        pass


def allowed(rel):
    if rel.startswith('/') or '\\' in rel or any(p in ('', '.', '..') for p in rel.split('/')):
        return False
    if rel in TOP_OK:
        return True
    return rel.startswith(TREE_OK) and os.path.splitext(rel)[1].lower() in EXTS


def rcon(server, command):
    props = {}
    try:
        for line in open(os.path.join(ROOT, server, 'server.properties')):
            if '=' in line:
                k, v = line.rstrip('\n').split('=', 1)
                props[k] = v
    except OSError:
        return None
    if props.get('enable-rcon') != 'true':
        return None
    def pack(i, t, body):
        p = struct.pack('<ii', i, t) + body.encode() + b'\0\0'
        return struct.pack('<i', len(p)) + p
    def read(s):
        n = struct.unpack('<i', s.recv(4))[0]
        buf = b''
        while len(buf) < n:
            buf += s.recv(n - len(buf))
        return struct.unpack('<ii', buf[:8])[0], buf[8:-2].decode('utf-8', 'replace')
    try:
        with socket.create_connection(('127.0.0.1', int(props.get('rcon.port', 0))), timeout=10) as s:
            s.sendall(pack(1, 3, props.get('rcon.password', '')))
            if read(s)[0] == -1:
                return None
            s.sendall(pack(2, 2, command))
            return re.sub('§.', '', read(s)[1])
    except (OSError, struct.error, ValueError):
        return None


def running(server):
    return subprocess.run(['systemctl', 'is-active', '--quiet', UNITS[server]]).returncode == 0


def minecraft_ids():
    """uid and gid the servers actually run as. Both must exist; a missing group would leave files
    as minecraft:root, which is not what plugin saves expect."""
    try:
        uid = pwd.getpwnam('minecraft').pw_uid
        gid = grp.getgrnam('minecraft').gr_gid
    except KeyError:
        sys.exit('refused: user and group minecraft must both exist')
    return uid, gid


def own(path, uid, gid):
    """chown path to uid:gid without following symlinks. Returns True if it changed."""
    if os.path.islink(path):
        raise Refused(f'{path} is a symlink')
    st = os.lstat(path)
    if st.st_uid == uid and st.st_gid == gid:
        return False
    os.chown(path, uid, gid, follow_symlinks=False)
    st = os.lstat(path)
    if st.st_uid != uid or st.st_gid != gid:
        raise Refused(f'could not chown {path} to minecraft:minecraft')
    return True


def ensure_dir_chain(base, rel_dir, uid, gid):
    """Create any missing directories under base and leave each one, including base, owned by uid:gid.

    Existing directories keep their mode (only ownership is repaired). New ones are 0755.
    Symlink components are refused so a link cannot point a deploy outside the server tree.
    """
    repaired = 0
    parts = [p for p in rel_dir.split('/') if p] if rel_dir else []
    for d in [base, *[os.path.join(base, *parts[:i + 1]) for i in range(len(parts))]]:
        if os.path.islink(d):
            raise Refused(f'{d} is a symlink')
        if os.path.exists(d) and not os.path.isdir(d):
            raise Refused(f'{d} is not a directory')
        if not os.path.isdir(d):
            os.mkdir(d, 0o755)
            os.chmod(d, 0o755)
        if own(d, uid, gid):
            repaired += 1
    return repaired


def install_file(base, rel, content, uid, gid):
    """Write rel under base, leaving the file minecraft-owned mode 0644. Returns directory repairs."""
    repaired = ensure_dir_chain(base, os.path.dirname(rel), uid, gid)
    dst = os.path.join(base, rel)
    if os.path.islink(dst):
        raise Refused(f'{rel} is a symlink')
    tmp = dst + '.deploy-tmp'
    # O_NOFOLLOW|O_EXCL: a leftover symlink here must not be followed while we are root.
    if os.path.lexists(tmp):
        if stat.S_ISDIR(os.lstat(tmp).st_mode):
            raise Refused(f'{tmp} is a directory')
        os.unlink(tmp)
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
    try:
        try:
            os.write(fd, content)
        finally:
            os.close(fd)
        os.chmod(tmp, 0o644)
        os.chown(tmp, uid, gid, follow_symlinks=False)
        os.replace(tmp, dst)
    finally:
        if os.path.lexists(tmp):
            try:
                os.unlink(tmp)
            except OSError:
                pass
    st = os.stat(dst)
    if st.st_uid != uid or st.st_gid != gid or stat.S_IMODE(st.st_mode) != 0o644:
        raise Refused(f'{rel} was not left owned by minecraft:minecraft mode 644')
    return repaired


def repair_ownership(base, rel, uid, gid):
    """Leave an already-correct file and its parent directories owned by uid:gid. Does not rewrite it."""
    repaired = ensure_dir_chain(base, os.path.dirname(rel), uid, gid)
    dst = os.path.join(base, rel)
    if not os.path.lexists(dst):
        return repaired
    if os.path.islink(dst):
        raise Refused(f'{rel} is a symlink')
    if os.path.isfile(dst) and own(dst, uid, gid):
        repaired += 1
    return repaired


def with_geyser_format_version(rel, content):
    if not (rel.startswith('plugins/Geyser-') and rel.endswith('/custom_mappings/bellcraft_radio_sounds.json')):
        return content, None
    try:
        data = json.loads(content.decode('utf-8'))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return content, None
    if not isinstance(data, dict) or 'format_version' in data:
        return content, None
    if 'items' in data:
        version = 2
    elif 'blocks' in data:
        version = 1
    else:
        version = 1
    updated = {'format_version': version}
    updated.update(data)
    return json.dumps(updated, ensure_ascii=False, separators=(',', ':')).encode('utf-8'), version


def apply(server):
    # Resolve before reading the tar so a missing minecraft user fails immediately, on every server.
    uid, gid = minecraft_ids()
    data = sys.stdin.buffer.read(MAX_TAR + 1)
    if len(data) > MAX_TAR:
        sys.exit('refused: upload larger than 64 MB')
    base = os.path.join(ROOT, server)
    prefix = f'servers/{server}/'
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    backup = os.path.join(ROOT, '_backups', 'deploy', stamp, server)
    changed, same, refused, deleted = [], 0, [], []
    repaired = 0

    def backup_file(rel):
        src = os.path.join(base, rel)
        if os.path.isfile(src):
            dst = os.path.join(backup, rel)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copy2(src, dst)

    def install(rel, content):
        nonlocal repaired
        repaired += install_file(base, rel, content, uid, gid)

    deletes = []
    with tarfile.open(fileobj=io.BytesIO(data), mode='r:*') as tar:
        for m in tar:
            if m.isdir():
                continue
            if not m.name.startswith(prefix):
                refused.append(f'{m.name} (outside {prefix})')
                continue
            rel = m.name[len(prefix):]
            if rel == '.deploy-delete' and m.isfile():
                deletes = [l.strip() for l in tar.extractfile(m).read().decode().splitlines() if l.strip()]
                continue
            if not m.isfile():
                refused.append(f'{rel} (not a regular file)')
                continue
            if not allowed(rel):
                refused.append(f'{rel} (not a deployable path)')
                continue
            content = tar.extractfile(m).read()
            if MARK in content:
                refused.append(f'{rel} (contains <<REDACTED>> - edit it on the server)')
                continue
            content, version = with_geyser_format_version(rel, content)
            if version is not None:
                log(f'  normalized {rel}: added format_version={version}')
            dst = os.path.join(base, rel)
            try:
                if os.path.isfile(dst) and not os.path.islink(dst):
                    with open(dst, 'rb') as f:
                        current = f.read()
                    if current == content:
                        repaired += repair_ownership(base, rel, uid, gid)
                        same += 1
                        continue
                backup_file(rel)
                install(rel, content)
                changed.append(rel)
            except Refused as e:
                refused.append(f'{rel} ({e})')

    for rel in deletes:
        dst = os.path.join(base, rel)
        if not allowed(rel):
            refused.append(f'delete {rel} (not a deployable path)')
        elif os.path.isfile(dst):
            backup_file(rel)
            os.remove(dst)
            deleted.append(rel)

    log(f'apply {server}: {len(changed)} changed, {len(deleted)} deleted, {same} unchanged, {len(refused)} refused'
        + (f', ownership repaired {repaired}' if repaired else '')
        + (f', backup {backup}' if changed or deleted else ''))
    for r in changed:
        log(f'  + {r}')
    for r in deleted:
        log(f'  - {r}')
    for r in refused:
        log(f'  ! refused {r}')

    touched = changed + deleted
    scripts = sorted({os.path.basename(r) for r in touched
                      if r.startswith('plugins/Skript/scripts/') and r.endswith('.sk')})
    others = sorted({'/'.join(r.split('/')[:2]) for r in touched if not r.startswith('plugins/Skript/scripts/')})
    if scripts:
        if server != 'proxy' and running(server):
            for sk in scripts:
                reply = rcon(server, f'sk reload {sk[:-3]}')
                log(f'  sk reload {sk}: ' + ((reply or 'no RCON reply').strip().replace('\n', ' ')[:200]))
            log('  NOTE: Skript only prints parse errors at boot. If a script misbehaves, restart and read the log.')
        else:
            log(f'  {server} is not running; scripts load on next start')
    if others:
        log('  Needs a plugin reload or a restart to take effect: ' + ', '.join(others))
    if refused:
        sys.exit(2)


def main():
    cmd = os.environ.get('SSH_ORIGINAL_COMMAND')
    args = shlex.split(cmd) if cmd else sys.argv[1:]
    if not args:
        sys.exit('usage: export [server ...] | apply <server> | status')
    action, rest = args[0], args[1:]
    if action == 'export':
        if any(s not in SERVERS for s in rest):
            sys.exit('unknown server')
        os.execv('/usr/bin/python3', ['python3', EXPORT] + rest)
    if action == 'status':
        for s in SERVERS:
            print(f'{s:10} {"running" if running(s) else "stopped"}')
        return
    if action == 'apply' and len(rest) == 1 and rest[0] in SERVERS:
        with open('/run/bellcraft-deploy.lock', 'w') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            apply(rest[0])
        return
    sys.exit(f'refused: {" ".join(args)[:100]}')


if __name__ == '__main__':
    main()
