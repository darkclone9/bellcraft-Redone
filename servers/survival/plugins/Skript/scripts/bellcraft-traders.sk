# Bellcraft hired traders (RPG survival)
#
# A player hires an unnamed adult villager inside their own Towny town. The villager
# then sells items that player stocked. Rent is 50 of the server's Vault balance
# (CMI), taken from the MMOProfiles character that hired the stall, and deposited
# into that town's Towny bank with /t deposit (the same command town-economy.sk uses).
# One payment covers one day. Missed days are not back-charged. When the day runs
# out the stall stops selling, and it renews on its own once that same character is
# online, away from profile selection, and can pay. /hiretrader pay does the same
# thing by hand.
#
# If the town is gone, the player is no longer in that town, or Towny does not take
# the fee, nothing is marked paid and the items stay stored. Skript cannot read
# whether /t deposit succeeded, so success is the Vault balance dropping by the fee.
#
# Sale money is stored on the stall ({bctrader::%id%::purse}) and paid only while
# the hiring character is the active one. Otherwise it stays on the stall, or in
# {bctrader::held::} after the stall is dismissed, until /hiretrader collect.
#
# Needs a full boot of the backend to confirm it parsed. sk reload hides errors.

options:
    prefix: &8[&6Trader&8] &r
    daily-fee: 50
    max-traders: 2
    min-price: 1
    max-price: 1000000
    reach: 5
    stock-title: &8Stall Stock
    shop-title: &8Stall
    select-x: 239.5
    select-y: 74
    select-z: 208.5
    select-radius: 12

# ---------------------------------------------------------------- helpers

function traderOpen(id: text) :: boolean:
    if {bctrader::%{_id}%::until} is not set:
        return false
    if {bctrader::%{_id}%::until} < now:
        return false
    return true

function traderCount(uuid: text) :: number:
    set {_n} to 0
    if {bctrader::list::*} is not set:
        return 0
    loop {bctrader::list::*}:
        set {_id} to loop-value
        if {bctrader::%{_id}%::owner} is {_uuid}:
            if {bctrader::%{_id}%::missing} is not set:
                add 1 to {_n}
    return {_n}

function traderStockCount(id: text) :: number:
    set {_n} to 0
    loop 18 times:
        set {_slot} to loop-number - 1
        if {bctrader::%{_id}%::item::%{_slot}%} is set:
            add 1 to {_n}
    return {_n}

function traderMob(id: text) :: entity:
    set {_e} to {bctrader::%{_id}%::entity}
    if {_e} is set:
        if {_e} is alive:
            if "%uuid of {_e}%" is {_id}:
                return {_e}

function traderBlank(raw: text) :: boolean:
    if {_raw} is not set:
        return true
    if {_raw} is "":
        return true
    if {_raw} is "None":
        return true
    if {_raw} is "none":
        return true
    if {_raw} is "N/A":
        return true
    if {_raw} is "n/a":
        return true
    if {_raw} is "null":
        return true
    if {_raw} is "-":
        return true
    if {_raw} is "Wilderness":
        return true
    if {_raw} is "wilderness":
        return true
    if {_raw} contains "townyadvanced":
        return true
    if {_raw} contains "mmoprofiles":
        return true
    return false

function traderProfile(p: player) :: text:
    set {_id} to placeholder "mmoprofiles_current_profile_uuid" from {_p}
    if traderBlank({_id}) is true:
        return ""
    set {_id} to {_id} in lowercase
    return {_id}

function traderOwnsCharacter(p: player, id: text) :: boolean:
    if "%uuid of {_p}%" is not {bctrader::%{_id}%::owner}:
        return false
    set {_need} to {bctrader::%{_id}%::profile}
    if traderBlank({_need}) is true:
        return false
    set {_need} to {_need} in lowercase
    set {_have} to traderProfile({_p})
    if {_have} is "":
        return false
    if {_have} is {_need}:
        return true
    return false

function awayFromSelect(p: player) :: boolean:
    if "%world of {_p}%" is not "world":
        return true
    set {_spot} to location({@select-x}, {@select-y}, {@select-z}, world "world")
    if distance between {_p} and {_spot} > {@select-radius}:
        return true
    return false

function traderTownName(p: player) :: text:
    set {_mine} to placeholder "townyadvanced_town" from {_p}
    if traderBlank({_mine}) is true:
        return ""
    set {_mine} to uncolored {_mine}
    if traderBlank({_mine}) is true:
        return ""
    return {_mine}

function traderPlotTown(p: player) :: text:
    set {_here} to placeholder "townyadvanced_player_location_town_or_wildname" from {_p}
    if traderBlank({_here}) is true:
        return ""
    set {_here} to uncolored {_here}
    if traderBlank({_here}) is true:
        return ""
    return {_here}

function traderTownOk(p: player) :: boolean:
    set {_mine} to traderTownName({_p})
    if {_mine} is "":
        return false
    set {_here} to traderPlotTown({_p})
    if {_here} is {_mine}:
        return true
    return false

function traderStallTown(p: player, id: text) :: text:
    set {_stored} to {bctrader::%{_id}%::town}
    set {_mob} to traderMob({_id})
    if {_mob} is set:
        if distance between {_p} and {_mob} <= {@reach}:
            set {_here} to traderPlotTown({_p})
            if {_here} is "":
                delete {bctrader::%{_id}%::town}
                return ""
            set {bctrader::%{_id}%::town} to {_here}
            return {_here}
    if traderBlank({_stored}) is true:
        return ""
    return {_stored}

function traderTarget(p: player) :: entity:
    set {_e} to targeted entity of {_p}
    if {_e} is not set:
        stop
    if {_e} is not a villager:
        stop
    if distance between {_p} and {_e} > {@reach}:
        stop
    return {_e}

function traderTagged(e: entity) :: boolean:
    set {_tags::*} to scoreboard tags of {_e}
    if {_tags::*} contains "bellcraft_trader":
        return true
    if {_tags::*} contains "CITIZENS_NPC":
        return true
    return false

function traderAddPurse(id: text, amount: number):
    if {bctrader::%{_id}%::purse} is not set:
        set {bctrader::%{_id}%::purse} to 0
    add {_amount} to {bctrader::%{_id}%::purse}

function traderFlushHeld(p: player) :: number:
    if awayFromSelect({_p}) is false:
        return 0
    set {_profile} to traderProfile({_p})
    if {_profile} is not set:
        return 0
    if {_profile} is "":
        return 0
    set {_uuid} to "%uuid of {_p}%"
    set {_amt} to {bctrader::held::%{_uuid}%::%{_profile}%}
    if {_amt} is not set:
        return 0
    if {_amt} <= 0:
        return 0
    add {_amt} to {_p}'s balance
    delete {bctrader::held::%{_uuid}%::%{_profile}%}
    return {_amt}

function traderFlushStall(p: player, id: text) :: number:
    if traderOwnsCharacter({_p}, {_id}) is false:
        return 0
    if awayFromSelect({_p}) is false:
        return 0
    set {_amt} to {bctrader::%{_id}%::purse}
    if {_amt} is not set:
        return 0
    if {_amt} <= 0:
        return 0
    add {_amt} to {_p}'s balance
    delete {bctrader::%{_id}%::purse}
    return {_amt}

function traderFlushOwned(p: player) :: number:
    set {_paid} to traderFlushHeld({_p})
    set {_uuid} to "%uuid of {_p}%"
    if {bctrader::list::*} is not set:
        return {_paid}
    loop {bctrader::list::*}:
        set {_id} to loop-value
        if {bctrader::%{_id}%::owner} is {_uuid}:
            set {_bit} to traderFlushStall({_p}, {_id})
            add {_bit} to {_paid}
    return {_paid}

function traderParkPurse(id: text) :: boolean:
    set {_amt} to {bctrader::%{_id}%::purse}
    if {_amt} is not set:
        return true
    if {_amt} <= 0:
        return true
    set {_owner} to {bctrader::%{_id}%::owner}
    set {_profile} to {bctrader::%{_id}%::profile}
    if {_owner} is not set:
        return false
    if traderBlank({_profile}) is true:
        return false
    set {_profile} to {_profile} in lowercase
    if {bctrader::held::%{_owner}%::%{_profile}%} is not set:
        set {bctrader::held::%{_owner}%::%{_profile}%} to 0
    add {_amt} to {bctrader::held::%{_owner}%::%{_profile}%}
    delete {bctrader::%{_id}%::purse}
    return true

function traderSettleMoney(p: player, id: text) :: boolean:
    set {_amt} to {bctrader::%{_id}%::purse}
    if {_amt} is not set:
        return true
    if {_amt} <= 0:
        return true
    if traderOwnsCharacter({_p}, {_id}) is true:
        if awayFromSelect({_p}) is true:
            set {_paid} to traderFlushStall({_p}, {_id})
            if {_paid} > 0:
                send "{@prefix}&aYour trader earned &f%{_paid}%&a. It is in this character's balance." to {_p}
            return true
    if traderParkPurse({_id}) is true:
        send "{@prefix}&eEarnings from this stall stay saved for the character that hired it. Switch to that character and use &f/hiretrader collect&e." to {_p}
        return true
    send "{@prefix}&cThis stall has earnings that are not tied to a character, so it was left in place and the money was not moved." to {_p}
    return false

function traderPayTownNow(p: player, town: text) :: text:
    if traderBlank({_town}) is true:
        return "town"
    set {_mine} to traderTownName({_p})
    if {_mine} is not {_town}:
        return "town"
    set {_bal} to {_p}'s balance
    if {_bal} < {@daily-fee}:
        return "funds"
    set {_fee} to {@daily-fee}
    make {_p} execute command "t deposit %{_fee}%"
    set {_after} to {_p}'s balance
    if {_after} > ({_bal} - {_fee}) + 0.001:
        if {_after} < ({_bal} - 0.001):
            return "partial"
        return "town"
    return "ok"

function traderCreditTown(p: player, id: text) :: text:
    if traderOpen({_id}) is true:
        return "open"
    if "%uuid of {_p}%" is not {bctrader::%{_id}%::owner}:
        return "owner"
    if traderOwnsCharacter({_p}, {_id}) is false:
        return "character"
    if awayFromSelect({_p}) is false:
        return "select"
    set {_town} to traderStallTown({_p}, {_id})
    set {_why} to traderPayTownNow({_p}, {_town})
    if {_why} is not "ok":
        return {_why}
    if traderBlank({_town}) is false:
        set {bctrader::%{_id}%::town} to {_town}
    set {_until} to now
    add 1 day to {_until}
    set {bctrader::%{_id}%::until} to {_until}
    delete {bctrader::%{_id}%::told}
    return "ok"

function traderSayRent(p: player, id: text, why: text):
    if {_why} is "ok":
        set {_town} to {bctrader::%{_id}%::town}
        send "{@prefix}&aPaid &f{@daily-fee}% &ainto the &f%{_town}% &atown bank. This trader is selling again." to {_p}
    else if {_why} is "open":
        set {_left} to difference between now and {bctrader::%{_id}%::until}
        send "{@prefix}&7Already paid. Selling for another %{_left}%." to {_p}
    else if {_why} is "funds":
        set {_bal} to {_p}'s balance
        send "{@prefix}&cYou need &f{@daily-fee}%&c on this character. Balance: &f%{_bal}%&c. Nothing was taken. The stall stays closed and your items stay stored." to {_p}
    else if {_why} is "character":
        send "{@prefix}&cThis stall was hired by another character. Switch to that character to pay the rent. Nothing was charged." to {_p}
    else if {_why} is "select":
        send "{@prefix}&cLeave the character-selection area before paying rent. Nothing was charged." to {_p}
    else if {_why} is "partial":
        send "{@prefix}&cYour balance changed, but not by the full &f{@daily-fee}%&c rent, so this stall was not marked paid. Check the town bank. Your items stay stored." to {_p}
    else if {_why} is "town":
        send "{@prefix}&cThe rent was not taken. It has to reach the town bank of the town this stall stands in, and that bank could not be credited. The stall stays closed and your items stay stored." to {_p}
    else:
        send "{@prefix}&cThe rent was not taken. The stall stays closed and your items stay stored." to {_p}

function traderTouch(mob: entity, id: text):
    make {_mob} invulnerable
    set AI of {_mob} to false
    make {_mob} silent
    show the custom name of {_mob}
    add "bellcraft_trader" to scoreboard tags of {_mob}
    set profession of {_mob} to nitwit
    set {_who} to {bctrader::%{_id}%::ownername}
    if traderOpen({_id}) is true:
        set custom name of {_mob} to "&6Trader &7| &f%{_who}%"
    else:
        set custom name of {_mob} to "&cTrader &7| &f%{_who}% &8(closed)"
    set {bctrader::%{_id}%::entity} to {_mob}

function traderRelease(mob: entity):
    make {_mob} vulnerable
    set AI of {_mob} to true
    unsilence {_mob}
    set profession of {_mob} to none
    hide the custom name of {_mob}
    set custom name of {_mob} to ""
    remove "bellcraft_trader" from scoreboard tags of {_mob}

function traderForget(id: text):
    delete {bctrader::%{_id}%::item::*}
    delete {bctrader::%{_id}%::price::*}
    delete {bctrader::%{_id}%::owner}
    delete {bctrader::%{_id}%::ownername}
    delete {bctrader::%{_id}%::profile}
    delete {bctrader::%{_id}%::until}
    delete {bctrader::%{_id}%::entity}
    delete {bctrader::%{_id}%::missing}
    delete {bctrader::%{_id}%::town}
    delete {bctrader::%{_id}%::purse}
    delete {bctrader::%{_id}%::told}
    remove {_id} from {bctrader::list::*}

function traderGiveAll(p: player, id: text) :: boolean:
    loop 18 times:
        set {_slot} to loop-number - 1
        set {_it} to {bctrader::%{_id}%::item::%{_slot}%}
        if {_it} is set:
            if {_p} can hold {_it}:
                give {_it} to {_p}
                delete {bctrader::%{_id}%::item::%{_slot}%}
                delete {bctrader::%{_id}%::price::%{_slot}%}
            else:
                return false
    return true

function traderDecorate(stack: item, price: number, mode: text) :: item:
    set {_show} to {_stack}
    set {_lore::*} to lore of {_show}
    add "" to {_lore::*}
    if {_mode} is "stock":
        if {_price} > 0:
            add "&7Price each: &a%{_price}%" to {_lore::*}
            add "&eLeft click to change the price" to {_lore::*}
            add "&7Shift click takes it back" to {_lore::*}
        else:
            add "&cNot for sale yet" to {_lore::*}
            add "&eLeft click sets the price" to {_lore::*}
            add "&7Shift click takes it back" to {_lore::*}
    else if {_mode} is "shop":
        add "&7Price each: &a%{_price}%" to {_lore::*}
        add "&eLeft click buys 1" to {_lore::*}
        add "&eShift click buys as many as you can pay for" to {_lore::*}
    else:
        add "&7Price each: &a%{_price}%" to {_lore::*}
        add "&cRent is unpaid" to {_lore::*}
        add "&7This stall is not selling." to {_lore::*}
        add "&7The owner's items stay stored." to {_lore::*}
    set lore of {_show} to {_lore::*}
    return {_show}

function traderShowStock(p: player, id: text):
    set {_inv} to chest inventory with 3 rows named "{@stock-title}"
    loop 27 times:
        set slot (loop-number - 1) of {_inv} to gray stained glass pane named " "
    loop 18 times:
        set {_slot} to loop-number - 1
        set {_it} to {bctrader::%{_id}%::item::%{_slot}%}
        if {_it} is set:
            set {_price} to {bctrader::%{_id}%::price::%{_slot}%}
            if {_price} is not set:
                set {_price} to 0
            set slot {_slot} of {_inv} to traderDecorate({_it}, {_price}, "stock")
        else:
            set slot {_slot} of {_inv} to light gray stained glass pane named "&8Empty" with lore "&7Shift-click an item in your inventory" and "&7to stock this stall."
    if traderOpen({_id}) is true:
        set {_left} to difference between now and {bctrader::%{_id}%::until}
        set {_status} to "&aOpen &7- %{_left}% left"
    else:
        set {_status} to "&cClosed &7- rent due. Items are still here."
    set {_town} to {bctrader::%{_id}%::town}
    set slot 19 of {_inv} to emerald named "&aRent" with lore "&7Fee: &f{@daily-fee}% &7for 1 day, into the &f%{_town}% &7town bank" and "%{_status}%" and "&eClick to pay one day if it is closed." and "&7Only the character that hired this stall can pay."
    set slot 21 of {_inv} to book named "&eHow this stall works" with lore "&7Shift-click items from your inventory." and "&7Left click a stocked item, then type a price." and "&7Shift click a stocked item to take it back." and "&7Sales pay the character that hired it." and "&7/hiretrader collect pays held earnings." and "&7/hiretrader dismiss returns every item."
    set slot 22 of {_inv} to paper named "&7Retire" with lore "&7Look at this trader and run" and "&f/hiretrader dismiss" and "&7You get every item back." and "&7Make inventory space first."
    set {bctrader::view::%uuid of {_p}%::id} to {_id}
    set {bctrader::view::%uuid of {_p}%::mode} to "stock"
    open {_inv} to {_p}

function traderShowShop(p: player, id: text):
    set {_inv} to chest inventory with 3 rows named "{@shop-title}"
    loop 27 times:
        set slot (loop-number - 1) of {_inv} to gray stained glass pane named " "
    set {_selling} to traderOpen({_id})
    set {_owner} to {bctrader::%{_id}%::ownername}
    set {_shown} to 0
    loop 18 times:
        set {_slot} to loop-number - 1
        set {_it} to {bctrader::%{_id}%::item::%{_slot}%}
        set {_price} to {bctrader::%{_id}%::price::%{_slot}%}
        if {_it} is set:
            if {_price} is set:
                if {_price} >= {@min-price}:
                    if {_selling} is true:
                        set slot {_slot} of {_inv} to traderDecorate({_it}, {_price}, "shop")
                    else:
                        set slot {_slot} of {_inv} to traderDecorate({_it}, {_price}, "closed")
                    add 1 to {_shown}
    if {_shown} is 0:
        set slot 13 of {_inv} to paper named "&7Nothing for sale" with lore "&7This stall has no priced items."
    if {_selling} is true:
        set slot 22 of {_inv} to emerald named "&a%{_owner}%'s stall" with lore "&7Prices are per item." and "&7Money is held for the character that hired this stall."
    else:
        set slot 22 of {_inv} to barrier named "&cStall closed" with lore "&7Rent is unpaid, so nothing can be bought." and "&7The owner's items are stored, not lost."
    set {bctrader::view::%uuid of {_p}%::id} to {_id}
    set {bctrader::view::%uuid of {_p}%::mode} to "shop"
    open {_inv} to {_p}

function traderNoteEarnings(p: player, amount: number):
    if {_amount} > 0:
        send "{@prefix}&aYour trader earned &f%{_amount}%&a. It is in this character's balance." to {_p}

function traderHire(p: player):
    set {_e} to traderTarget({_p})
    if {_e} is not set:
        send "{@prefix}&7Look at an unnamed adult villager and run &f/hiretrader&7." to {_p}
        send "{@prefix}&7You must be inside your own town. Rent is &f{@daily-fee}% &7a day, paid into that town's bank." to {_p}
        stop
    set {_id} to "%uuid of {_e}%"
    if {bctrader::%{_id}%::owner} is set:
        if {bctrader::%{_id}%::owner} is "%uuid of {_p}%":
            set {_paid} to traderFlushStall({_p}, {_id})
            traderNoteEarnings({_p}, {_paid})
            if {_p} is sneaking:
                traderShowStock({_p}, {_id})
            else:
                traderShowShop({_p}, {_id})
        else:
            set {_who} to {bctrader::%{_id}%::ownername}
            send "{@prefix}&c%{_who}% &7already hired that villager." to {_p}
        stop
    if traderTagged({_e}) is true:
        send "{@prefix}&cThat villager is already spoken for." to {_p}
        stop
    if {_e} is an adult:
        set {_adult} to true
    else:
        send "{@prefix}&cYou can only hire an adult villager." to {_p}
        stop
    set {_cn} to custom name of {_e}
    if {_cn} is set:
        if {_cn} is not "":
            send "{@prefix}&cThat villager already has a name, so it was left alone." to {_p}
            stop
    if traderTownOk({_p}) is false:
        send "{@prefix}&cHire a villager inside your own town, not in the wilderness or someone else's town." to {_p}
        stop
    set {_uuid} to "%uuid of {_p}%"
    if traderCount({_uuid}) >= {@max-traders}:
        send "{@prefix}&cYou already have &f{@max-traders}% &ctraders. Dismiss one first." to {_p}
        stop
    set {_profile} to traderProfile({_p})
    if {_profile} is not set:
        send "{@prefix}&cCould not read which character is active, so the villager was not hired." to {_p}
        stop
    if {_profile} is "":
        send "{@prefix}&cCould not read which character is active, so the villager was not hired." to {_p}
        stop
    if awayFromSelect({_p}) is false:
        send "{@prefix}&cLeave the character-selection area before hiring a trader." to {_p}
        stop
    set {_town} to traderTownName({_p})
    set {_bal} to {_p}'s balance
    if {_bal} < {@daily-fee}:
        send "{@prefix}&cHiring costs &f{@daily-fee}%&c, paid into the &f%{_town}% &ctown bank. Your balance is &f%{_bal}%&c." to {_p}
        stop
    set {_why} to traderPayTownNow({_p}, {_town})
    if {_why} is not "ok":
        if {_why} is "partial":
            send "{@prefix}&cYour balance changed, but not by the full rent, so the villager was not hired. Check the town bank before trying again." to {_p}
        else:
            send "{@prefix}&cThe rent could not be paid into the &f%{_town}% &ctown bank, so the villager was not hired." to {_p}
        stop
    set {_until} to now
    add 1 day to {_until}
    set {bctrader::%{_id}%::owner} to {_uuid}
    set {bctrader::%{_id}%::ownername} to "%{_p}%"
    set {bctrader::%{_id}%::profile} to {_profile}
    set {bctrader::%{_id}%::until} to {_until}
    set {bctrader::%{_id}%::town} to {_town}
    delete {bctrader::%{_id}%::missing}
    delete {bctrader::%{_id}%::purse}
    if {bctrader::list::*} does not contain {_id}:
        add {_id} to {bctrader::list::*}
    traderTouch({_e}, {_id})
    send "{@prefix}&aHired. &f{@daily-fee}% &apaid into the &f%{_town}% &atown bank for one day." to {_p}
    send "{@prefix}&7Sneak and click the trader to stock it. Other players click to buy." to {_p}
    send "{@prefix}&7Sales pay this character. If another character is online, the stall holds the money until you collect it." to {_p}
    send "{@prefix}&7If the rent lapses, selling stops. Your items stay until you take them." to {_p}
    traderShowStock({_p}, {_id})

function traderMaintain(p: player, id: text):
    if "%uuid of {_p}%" is not {bctrader::%{_id}%::owner}:
        stop
    if traderOwnsCharacter({_p}, {_id}) is false:
        stop
    if awayFromSelect({_p}) is false:
        stop
    set {_paid} to traderFlushHeld({_p})
    set {_bit} to traderFlushStall({_p}, {_id})
    add {_bit} to {_paid}
    traderNoteEarnings({_p}, {_paid})
    set {_before} to traderOpen({_id})
    set {_why} to traderCreditTown({_p}, {_id})
    if {_before} is false:
        if {_why} is "ok":
            set {_mob} to traderMob({_id})
            if {_mob} is set:
                traderTouch({_mob}, {_id})
            traderSayRent({_p}, {_id}, {_why})
        else if {_why} is "open":
            stop
        else:
            if {bctrader::%{_id}%::told} is not set:
                set {bctrader::%{_id}%::told} to true
                set {_mob} to traderMob({_id})
                if {_mob} is set:
                    traderTouch({_mob}, {_id})
                traderSayRent({_p}, {_id}, {_why})

function traderKeep(id: text, slot: number, have: number):
    set {_back} to {bctrader::%{_id}%::item::%{_slot}%}
    if {_back} is set:
        set amount of {_back} to {_have}
        set {bctrader::%{_id}%::item::%{_slot}%} to {_back}

function traderBuy(p: player, id: text, slot: number, count: number):
    if {bctrader::%{_id}%::owner} is not set:
        send "{@prefix}&cThat stall is gone." to {_p}
        stop
    if traderOpen({_id}) is false:
        send "{@prefix}&cThis trader's rent is unpaid, so nothing is for sale. The stock has not been removed." to {_p}
        stop
    if "%uuid of {_p}%" is {bctrader::%{_id}%::owner}:
        send "{@prefix}&7This is your stall. Sneak and click the trader to stock it." to {_p}
        stop
    set {_buyer} to traderProfile({_p})
    if {_buyer} is not set:
        send "{@prefix}&cFinish choosing a character before buying." to {_p}
        stop
    if {_buyer} is "":
        send "{@prefix}&cFinish choosing a character before buying." to {_p}
        stop
    if awayFromSelect({_p}) is false:
        send "{@prefix}&cLeave the character-selection area before buying." to {_p}
        stop
    set {_price} to {bctrader::%{_id}%::price::%{_slot}%}
    if {_price} is not set:
        stop
    if {_price} < {@min-price}:
        stop
    set {_it} to {bctrader::%{_id}%::item::%{_slot}%}
    if {_it} is not set:
        stop
    set {_have} to amount of {_it}
    if {_count} > {_have}:
        set {_count} to {_have}
    if {_count} < 1:
        stop
    set {_cost} to {_price} * {_count}
    set {_bal} to {_p}'s balance
    if {_bal} < {_cost}:
        send "{@prefix}&cThat costs &f%{_cost}%&c. Your balance is &f%{_bal}%&c." to {_p}
        stop
    set {_sample} to {bctrader::%{_id}%::item::%{_slot}%}
    set amount of {_sample} to {_count}
    if {_p} can hold {_sample}:
        set {_fits} to true
    else:
        traderKeep({_id}, {_slot}, {_have})
        send "{@prefix}&cMake space in your inventory first." to {_p}
        stop
    set {_bal} to {_p}'s balance
    remove {_cost} from {_p}'s balance
    if {_p}'s balance > ({_bal} - {_cost}) + 0.001:
        traderKeep({_id}, {_slot}, {_have})
        send "{@prefix}&cThe payment could not be taken." to {_p}
        stop
    set {_left} to {_have} - {_count}
    if {_left} < 1:
        delete {bctrader::%{_id}%::item::%{_slot}%}
        delete {bctrader::%{_id}%::price::%{_slot}%}
    else:
        set {_stored} to {bctrader::%{_id}%::item::%{_slot}%}
        set amount of {_stored} to {_left}
        set {bctrader::%{_id}%::item::%{_slot}%} to {_stored}
    give {_sample} to {_p}
    traderAddPurse({_id}, {_cost})
    set {_seller} to {bctrader::%{_id}%::owner}
    set {_sellerPlayer} to player({_seller})
    if {_sellerPlayer} is set:
        set {_bit} to traderFlushStall({_sellerPlayer}, {_id})
        if {_bit} > 0:
            send "{@prefix}&aYour trader earned &f%{_bit}%&a. It is in this character's balance." to {_sellerPlayer}
        else:
            send "{@prefix}&eYour trader sold something for &f%{_cost}%&e. It is held for the character that hired this stall. &f/hiretrader collect" to {_sellerPlayer}
    send "{@prefix}&aBought &f%{_count}% &afor &f%{_cost}%&a." to {_p}
    play sound "entity.villager.yes" with volume 0.6 and pitch 1.2 at {_p}
    traderShowShop({_p}, {_id})

function traderDismiss(p: player):
    set {_e} to traderTarget({_p})
    if {_e} is not set:
        send "{@prefix}&cLook at your trader, then run &f/hiretrader dismiss&c." to {_p}
        stop
    set {_id} to "%uuid of {_e}%"
    if {bctrader::%{_id}%::owner} is not "%uuid of {_p}%":
        send "{@prefix}&cYou can only dismiss a trader you hired." to {_p}
        stop
    if traderGiveAll({_p}, {_id}) is false:
        send "{@prefix}&eYour inventory filled up. What fit was returned. Make space and dismiss again for the rest." to {_p}
        traderShowStock({_p}, {_id})
        stop
    if traderSettleMoney({_p}, {_id}) is false:
        stop
    traderRelease({_e})
    traderForget({_id})
    send "{@prefix}&aDismissed. Every stored item was returned. Today's rent is not refunded." to {_p}

function traderRecover(p: player):
    set {_uuid} to "%uuid of {_p}%"
    set {_any} to false
    if {bctrader::list::*} is not set:
        send "{@prefix}&7You have no lost traders." to {_p}
        stop
    set {_ids::*} to {bctrader::list::*}
    loop {_ids::*}:
        set {_id} to loop-value
        if {bctrader::%{_id}%::owner} is {_uuid}:
            if {bctrader::%{_id}%::missing} is set:
                set {_any} to true
                if traderGiveAll({_p}, {_id}) is true:
                    if traderSettleMoney({_p}, {_id}) is true:
                        traderForget({_id})
                        send "{@prefix}&aRecovered the stock from a trader that died." to {_p}
                    else:
                        stop
                else:
                    send "{@prefix}&eMake more inventory space, then run &f/hiretrader recover&e again." to {_p}
                    stop
    if {_any} is false:
        send "{@prefix}&7None of your traders are missing. Stand next to one and use &f/hiretrader dismiss&7." to {_p}

function traderInfo(p: player):
    set {_uuid} to "%uuid of {_p}%"
    send "{@prefix}&7Your traders (rent &f{@daily-fee}%&7 each day into the town bank, up to &f{@max-traders}%&7):" to {_p}
    set {_any} to false
    if {bctrader::list::*} is set:
        loop {bctrader::list::*}:
            set {_id} to loop-value
            if {bctrader::%{_id}%::owner} is {_uuid}:
                set {_any} to true
                set {_n} to traderStockCount({_id})
                set {_town} to {bctrader::%{_id}%::town}
                if {bctrader::%{_id}%::missing} is set:
                    send " &8- &cmissing villager &7in &f%{_town}% &7- &f%{_n}% &7stacks waiting. &f/hiretrader recover" to {_p}
                else if traderOpen({_id}) is true:
                    set {_left} to difference between now and {bctrader::%{_id}%::until}
                    send " &8- &aopen &7in &f%{_town}% &7- &f%{_n}% &7stacks &7- %{_left}% left" to {_p}
                else:
                    send " &8- &cclosed &7in &f%{_town}% &7- rent due &7- &f%{_n}% &7stacks still stored" to {_p}
                set {_purse} to {bctrader::%{_id}%::purse}
                if {_purse} is set:
                    if {_purse} > 0:
                        if traderOwnsCharacter({_p}, {_id}) is true:
                            send "    &7earnings waiting for this character: &f%{_purse}% &7- &f/hiretrader collect" to {_p}
                        else:
                            send "    &7earnings waiting for the character that hired it: &f%{_purse}%" to {_p}
    if {_any} is false:
        send " &8- &7None. Look at a villager in your town and run &f/hiretrader&7." to {_p}
    set {_profile} to traderProfile({_p})
    if {_profile} is not "":
        set {_held} to {bctrader::held::%{_uuid}%::%{_profile}%}
        if {_held} is set:
            if {_held} > 0:
                send "{@prefix}&7Saved earnings for this character: &f%{_held}% &7- &f/hiretrader collect" to {_p}

function traderPay(p: player):
    set {_uuid} to "%uuid of {_p}%"
    set {_e} to traderTarget({_p})
    if {_e} is set:
        set {_id} to "%uuid of {_e}%"
        if {bctrader::%{_id}%::owner} is {_uuid}:
            set {_paid} to traderFlushStall({_p}, {_id})
            set {_held} to traderFlushHeld({_p})
            add {_held} to {_paid}
            traderNoteEarnings({_p}, {_paid})
            if traderOpen({_id}) is true:
                set {_left} to difference between now and {bctrader::%{_id}%::until}
                send "{@prefix}&7Already paid. Selling for another %{_left}%." to {_p}
            else:
                set {_why} to traderCreditTown({_p}, {_id})
                if {_why} is "ok":
                    traderTouch({_e}, {_id})
                traderSayRent({_p}, {_id}, {_why})
            stop
    set {_paid} to traderFlushOwned({_p})
    traderNoteEarnings({_p}, {_paid})
    if {bctrader::list::*} is not set:
        send "{@prefix}&7You have no traders." to {_p}
        stop
    set {_closed} to 0
    set {_other} to 0
    loop {bctrader::list::*}:
        set {_id} to loop-value
        if {bctrader::%{_id}%::owner} is {_uuid}:
            if {bctrader::%{_id}%::missing} is not set:
                if traderOpen({_id}) is false:
                    if traderOwnsCharacter({_p}, {_id}) is false:
                        add 1 to {_other}
                    else:
                        add 1 to {_closed}
                        set {_why} to traderCreditTown({_p}, {_id})
                        if {_why} is "ok":
                            set {_mob} to traderMob({_id})
                            if {_mob} is set:
                                traderTouch({_mob}, {_id})
                            traderSayRent({_p}, {_id}, {_why})
                        else:
                            traderSayRent({_p}, {_id}, {_why})
                            stop
    if {_closed} is 0:
        if {_other} > 0:
            send "{@prefix}&7No closed stall for this character. Another character's stall was left unpaid. Switch to that character and run &f/hiretrader pay&7." to {_p}
        else:
            send "{@prefix}&7Your traders are already paid. Look at one and sneak-click it to stock it." to {_p}

function traderCollect(p: player):
    set {_profile} to traderProfile({_p})
    if {_profile} is "":
        send "{@prefix}&cFinish choosing a character before collecting trader earnings." to {_p}
        stop
    if awayFromSelect({_p}) is false:
        send "{@prefix}&cLeave the character-selection area before collecting. Earnings stay stored until this character is clear of it." to {_p}
        stop
    set {_paid} to traderFlushOwned({_p})
    if {_paid} > 0:
        send "{@prefix}&aCollected &f%{_paid}% &ainto this character's balance." to {_p}
    else:
        send "{@prefix}&7This character has no stall earnings waiting." to {_p}

function traderTryRenew(p: player, mob: entity, id: text):
    if traderOpen({_id}) is true:
        stop
    if traderOwnsCharacter({_p}, {_id}) is false:
        send "{@prefix}&cThis stall was hired by another character. Switch to that character to pay the rent. Nothing was charged." to {_p}
        stop
    set {_why} to traderCreditTown({_p}, {_id})
    if {_why} is "ok":
        traderTouch({_mob}, {_id})
    if {_why} is not "open":
        traderSayRent({_p}, {_id}, {_why})

# ---------------------------------------------------------------- events

on script load:
    log "[traders] bellcraft-traders loaded (fee %{@daily-fee}% into the town bank, max %{@max-traders}%, locked to the hiring character)"

on damage:
    victim is a villager
    set {_id} to "%uuid of victim%"
    if {bctrader::%{_id}%::owner} is not set:
        stop
    cancel event

on death:
    victim is a villager
    set {_id} to "%uuid of victim%"
    if {bctrader::%{_id}%::owner} is not set:
        stop
    set {bctrader::%{_id}%::missing} to true
    delete {bctrader::%{_id}%::entity}
    set {_who} to player({bctrader::%{_id}%::owner})
    if {_who} is set:
        send "{@prefix}&cYour trader died. Items are safe. Use &f/hiretrader recover&c." to {_who}

on right click on villager:
    set {_id} to "%uuid of event-entity%"
    if {bctrader::%{_id}%::owner} is not set:
        stop
    cancel event
    set {bctrader::%{_id}%::entity} to event-entity
    traderTouch(event-entity, {_id})
    if "%uuid of player%" is {bctrader::%{_id}%::owner}:
        if player is sneaking:
            traderShowStock(player, {_id})
        else:
            traderTryRenew(player, event-entity, {_id})
            set {_paid} to traderFlushStall(player, {_id})
            traderNoteEarnings(player, {_paid})
            traderShowShop(player, {_id})
    else:
        traderShowShop(player, {_id})

on inventory click:
    set {_title} to name of player's current inventory
    if {_title} is "{@stock-title}":
        cancel event
        set {_uuid} to "%uuid of player%"
        set {_id} to {bctrader::view::%{_uuid}%::id}
        if {_id} is not set:
            close player's inventory
            stop
        if {bctrader::%{_id}%::owner} is not {_uuid}:
            close player's inventory
            stop
        if clicked inventory is not set:
            stop
        set {_slot} to index of event-slot
        if {_slot} < 0:
            stop
        if name of clicked inventory is "{@stock-title}":
            if {_slot} is 19:
                set {_paid} to traderFlushStall(player, {_id})
                traderNoteEarnings(player, {_paid})
                if traderOpen({_id}) is true:
                    send "{@prefix}&7This stall is already paid for." to player
                else:
                    set {_why} to traderCreditTown(player, {_id})
                    if {_why} is "ok":
                        set {_mob} to traderMob({_id})
                        if {_mob} is set:
                            traderTouch({_mob}, {_id})
                    traderSayRent(player, {_id}, {_why})
                traderShowStock(player, {_id})
                stop
            if {_slot} >= 18:
                stop
            set {_it} to {bctrader::%{_id}%::item::%{_slot}%}
            if {_it} is not set:
                stop
            if "%click type%" contains "shift":
                if player can hold {_it}:
                    give {_it} to player
                    delete {bctrader::%{_id}%::item::%{_slot}%}
                    delete {bctrader::%{_id}%::price::%{_slot}%}
                    traderShowStock(player, {_id})
                else:
                    send "{@prefix}&cMake inventory space, then shift-click it again." to player
                stop
            set {bctrader::await::%{_uuid}%::id} to {_id}
            set {bctrader::await::%{_uuid}%::slot} to {_slot}
            close player's inventory
            send "{@prefix}&eType a price per item (&f{@min-price}%&e to &f{@max-price}%&e), or &ccancel&e." to player
            stop
        if "%click type%" contains "shift":
            if {_slot} > 35:
                send "{@prefix}&7Move that into your inventory first." to player
                stop
            set {_held} to event-item
            if {_held} is not set:
                stop
            if {_held} is air:
                stop
            set {_free} to -1
            loop 18 times:
                set {_s} to loop-number - 1
                if {_free} is -1:
                    if {bctrader::%{_id}%::item::%{_s}%} is not set:
                        set {_free} to {_s}
            if {_free} is -1:
                send "{@prefix}&cThis stall is full (18 stacks)." to player
                stop
            set {bctrader::%{_id}%::item::%{_free}%} to {_held}
            set slot {_slot} of player's inventory to air
            delete {bctrader::%{_id}%::price::%{_free}%}
            set {bctrader::await::%{_uuid}%::id} to {_id}
            set {bctrader::await::%{_uuid}%::slot} to {_free}
            close player's inventory
            send "{@prefix}&eStocked. Type a price per item, or &ccancel&e to leave it unpriced." to player
        stop
    if {_title} is "{@shop-title}":
        cancel event
        set {_uuid} to "%uuid of player%"
        set {_id} to {bctrader::view::%{_uuid}%::id}
        if {_id} is not set:
            close player's inventory
            stop
        if clicked inventory is not set:
            stop
        if name of clicked inventory is not "{@shop-title}":
            stop
        set {_slot} to index of event-slot
        if {_slot} < 0:
            stop
        if {_slot} >= 18:
            stop
        set {_count} to 1
        if "%click type%" contains "shift":
            set {_price} to {bctrader::%{_id}%::price::%{_slot}%}
            set {_it} to {bctrader::%{_id}%::item::%{_slot}%}
            if {_price} is not set:
                stop
            if {_it} is not set:
                stop
            if {_price} < {@min-price}:
                stop
            set {_count} to amount of {_it}
            set {_afford} to floor(player's balance / {_price})
            if {_count} > {_afford}:
                set {_count} to {_afford}
            if {_count} < 1:
                send "{@prefix}&cYou cannot afford one. Price each: &f%{_price}%&c." to player
                stop
        traderBuy(player, {_id}, {_slot}, {_count})

on quit:
    delete {bctrader::await::%uuid of player%::*}
    delete {bctrader::view::%uuid of player%::*}

on chat:
    set {_uuid} to "%uuid of player%"
    if {bctrader::await::%{_uuid}%::id} is not set:
        stop
    cancel event
    set {_id} to {bctrader::await::%{_uuid}%::id}
    set {_slot} to {bctrader::await::%{_uuid}%::slot}
    set {_raw} to message
    if {_raw} is "cancel":
        delete {bctrader::await::%{_uuid}%::*}
        send "{@prefix}&7Price unchanged. Click the trader to continue." to player
        stop
    set {_price} to {_raw} parsed as a number
    if {_price} is not set:
        delete {bctrader::await::%{_uuid}%::*}
        send "{@prefix}&cThat was not a number. Click the item again to set a price." to player
        stop
    set {_price} to floor({_price} * 100) / 100
    if {_price} < {@min-price}:
        delete {bctrader::await::%{_uuid}%::*}
        send "{@prefix}&cThe lowest price is &f{@min-price}%&c. Click the item again." to player
        stop
    if {_price} > {@max-price}:
        delete {bctrader::await::%{_uuid}%::*}
        send "{@prefix}&cThe highest price is &f{@max-price}%&c. Click the item again." to player
        stop
    if {bctrader::%{_id}%::item::%{_slot}%} is not set:
        delete {bctrader::await::%{_uuid}%::*}
        send "{@prefix}&cThat item is no longer in the stall." to player
        stop
    delete {bctrader::await::%{_uuid}%::*}
    set {bctrader::%{_id}%::price::%{_slot}%} to {_price}
    send "{@prefix}&aPrice set to &f%{_price}% &aper item." to player

on join:
    wait 8 seconds
    if player is not online:
        stop
    set {_profile} to traderProfile(player)
    if {_profile} is "":
        stop
    if awayFromSelect(player) is false:
        stop
    set {_paid} to traderFlushOwned(player)
    traderNoteEarnings(player, {_paid})
    set {_uuid} to "%uuid of player%"
    if {bctrader::list::*} is not set:
        stop
    loop {bctrader::list::*}:
        set {_id} to loop-value
        if {bctrader::%{_id}%::owner} is {_uuid}:
            if {bctrader::%{_id}%::missing} is set:
                send "{@prefix}&cA hired trader died. Your items are safe. &f/hiretrader recover" to player
            else if traderOwnsCharacter(player, {_id}) is true:
                if traderOpen({_id}) is false:
                    send "{@prefix}&cA trader of yours is closed until rent is paid. Items are stored. &f/hiretrader pay" to player

every 1 minute:
    if {bctrader::list::*} is not set:
        stop
    loop {bctrader::list::*}:
        set {_id} to loop-value
        set {_owner} to {bctrader::%{_id}%::owner}
        if {_owner} is set:
            set {_who} to player({_owner})
            if {_who} is set:
                if {bctrader::%{_id}%::missing} is set:
                    set {_bit} to traderFlushStall({_who}, {_id})
                    traderNoteEarnings({_who}, {_bit})
                else:
                    traderMaintain({_who}, {_id})

every 20 seconds:
    if {bctrader::list::*} is not set:
        stop
    loop all players:
        loop all living entities in radius 32 around loop-player:
            if loop-entity is a villager:
                set {_id} to "%uuid of loop-entity%"
                if {bctrader::%{_id}%::owner} is set:
                    if {bctrader::%{_id}%::missing} is not set:
                        set {_mob} to loop-entity
                        traderTouch({_mob}, {_id})

command /hiretrader [<text>]:
    description: Hire a villager to sell your items for a daily fee
    executable by: players
    trigger:
        if arg-1 is set:
            set {_parts::*} to arg-1 split at " "
            set {_sub} to {_parts::1}
        if {_sub} is not set:
            traderHire(player)
            stop
        if {_sub} is "":
            traderHire(player)
            stop
        if {_sub} is "help":
            send "{@prefix}&f/hiretrader &7- hire the villager you are looking at (&f{@daily-fee}%&7 into the town bank)" to player
            send "{@prefix}&f/hiretrader pay &7- pay a closed stall so it sells again" to player
            send "{@prefix}&f/hiretrader collect &7- take earnings onto the character that hired the stall" to player
            send "{@prefix}&f/hiretrader dismiss &7- retire the one you are looking at and take every item" to player
            send "{@prefix}&f/hiretrader recover &7- take items from a trader that died" to player
            send "{@prefix}&f/hiretrader info &7- list your stalls" to player
            stop
        if {_sub} is "info":
            traderInfo(player)
            stop
        if {_sub} is "pay":
            traderPay(player)
            stop
        if {_sub} is "collect":
            traderCollect(player)
            stop
        if {_sub} is "dismiss":
            traderDismiss(player)
            stop
        if {_sub} is "recover":
            traderRecover(player)
            stop
        send "{@prefix}&7Unknown. Try &f/hiretrader help&7." to player
