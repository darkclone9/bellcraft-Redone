# Bellcraft: character rename and icon
#
# Ported from Bellcraft-Classes#47 and fitted onto the switch that
# bellcraft-character.sk already owns (/character change → mmoprofiles quit
# from console). This script does not quit a profile and does not listen
# to join. Issue #16's select_last_profile_on_login stays the join path.
#
# MMOProfiles has no rename or icon API. Display names and icons are stored
# here and painted onto the "Choose Your Character" chest. The internal
# profile name is unchanged.
#
#   /characters        rename, icon, or hand off to /character change
#   /renamecharacter
#   /changeicon

options:
    prefix: &8[&d&lCharacters&8] &7
    menu-title: Your Characters
    confirm-title: Switch Character?
    icon-title: Choose an Icon
    select-title: Choose Your Character
    max-name-length: 20
    min-name-length: 2
    rename-timeout: 30

function charOfficialName(p: player) :: text:
    set {_n} to placeholder "mmoprofiles_current_profile_name" from {_p}
    if {_n} is not set:
        return ""
    if {_n} is "":
        return ""
    if {_n} contains "mmoprofiles_current_profile_name":
        return ""
    return {_n}

function charHasProfile(p: player) :: boolean:
    set {_n} to charOfficialName({_p})
    if {_n} is "":
        return false
    return true

function charShownNameFor(uuid: text, official: text) :: text:
    if {char::display::%{_uuid}%::%{_official}%} is set:
        return {char::display::%{_uuid}%::%{_official}%}
    return {_official}

function charDisplayName(p: player) :: text:
    set {_official} to charOfficialName({_p})
    if {_official} is "":
        return "Unknown"
    return charShownNameFor({_p}'s uuid, {_official})

function charIconIdOf(p: player) :: text:
    set {_official} to charOfficialName({_p})
    if {_official} is "":
        return "head"
    set {_uuid} to {_p}'s uuid
    if {char::icon::%{_uuid}%::%{_official}%} is set:
        return {char::icon::%{_uuid}%::%{_official}%}
    return "head"

function charIconItem(id: text) :: item:
    if {_id} is "sword":
        return iron sword
    if {_id} is "pearl":
        return ender pearl
    if {_id} is "amethyst":
        return amethyst shard
    if {_id} is "lamp":
        return redstone lamp
    if {_id} is "star":
        return nether star
    if {_id} is "shield":
        return shield
    if {_id} is "bow":
        return bow
    if {_id} is "blaze":
        return blaze rod
    if {_id} is "apple":
        return golden apple
    if {_id} is "diamond":
        return diamond
    if {_id} is "gold":
        return gold ingot
    if {_id} is "lapis":
        return lapis lazuli
    if {_id} is "netherite":
        return netherite ingot
    if {_id} is "bell":
        return bell
    if {_id} is "compass":
        return compass
    if {_id} is "clock":
        return clock
    if {_id} is "nametag":
        return name tag
    if {_id} is "enderchest":
        return ender chest
    if {_id} is "totem":
        return totem of undying
    if {_id} is "elytra":
        return elytra
    if {_id} is "trident":
        return trident
    if {_id} is "creeper":
        return creeper head
    if {_id} is "skeleton":
        return skeleton skull
    if {_id} is "zombie":
        return zombie head
    if {_id} is "dragon":
        return dragon head
    if {_id} is "wither":
        return wither skeleton skull
    return player head

