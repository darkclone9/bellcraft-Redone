# ==============================================================================
# Bellcraft Structure Registry (creative → survival)
# Canonical YAML: /opt/bellcraft/data/structures/registry.yml
# Data vars:      bellcraft_structures_data.sk (AUTO-GENERATED by bc-struct)
# Helper:         /opt/bellcraft/bin/bc-struct
# NOT BellcraftBuild (plot submissions).
#
# Permission: bellcraft.struct.admin
# Bridge: Skript logs [BCSTRUCT]|op|... ; bc-struct watch applies YAML updates.
# ==============================================================================

options:
	prefix: &8[&bBCStruct&8]&r

function bcstructExists(id: text) :: boolean:
	if {bcstruct::struct::%{_id}%::display} is set:
		return true
	return false

function bcstructBridge(payload: text):
	log "[BCSTRUCT] %{_payload}%"

function bcstructNearestId(p: player) :: text:
	set {_world} to "%world of {_p}%"
	set {_px} to x-coord of {_p}
	set {_py} to y-coord of {_p}
	set {_pz} to z-coord of {_p}
	set {_bestDist} to -1
	set {_bestId} to "none"
	loop {bcstruct::ids::*}:
		set {_id} to loop-value
		if {bcstruct::struct::%{_id}%::trackable} is false:
			continue
		set {_n} to {bcstruct::struct::%{_id}%::placement_count}
		if {_n} is not set:
			continue
		if {_n} < 1:
			continue
		set {_i} to 0
		while {_i} < {_n}:
			set {_raw} to {bcstruct::struct::%{_id}%::placement::%{_i}%}
			add 1 to {_i}
			if {_raw} is not set:
				continue
			set {_parts::*} to {_raw} split at "|"
			if size of {_parts::*} < 4:
				continue
			if {_parts::1} is not {_world}:
				continue
			set {_x} to {_parts::2} parsed as number
			set {_y} to {_parts::3} parsed as number
			set {_z} to {_parts::4} parsed as number
			if {_x} is not set:
				continue
			set {_dx} to {_x} - {_px}
			set {_dy} to {_y} - {_py}
			set {_dz} to {_z} - {_pz}
			set {_dist} to floor(sqrt(({_dx} * {_dx}) + ({_dy} * {_dy}) + ({_dz} * {_dz})))
			if {_bestDist} is -1:
				set {_bestDist} to {_dist}
				set {_bestId} to {_id}
			else if {_dist} < {_bestDist}:
				set {_bestDist} to {_dist}
				set {_bestId} to {_id}
	return {_bestId}

function bcstructNearestDisplay(p: player) :: text:
	set {_id} to bcstructNearestId({_p})
	if {_id} is "none":
		return "none"
	if {bcstruct::struct::%{_id}%::display} is set:
		return {bcstruct::struct::%{_id}%::display}
	return {_id}

function bcstructNearestDist(p: player) :: text:
	set {_world} to "%world of {_p}%"
	set {_px} to x-coord of {_p}
	set {_py} to y-coord of {_p}
	set {_pz} to z-coord of {_p}
	set {_bestDist} to -1
	loop {bcstruct::ids::*}:
		set {_id} to loop-value
		if {bcstruct::struct::%{_id}%::trackable} is false:
			continue
		set {_n} to {bcstruct::struct::%{_id}%::placement_count}
		if {_n} is not set:
			continue
		if {_n} < 1:
			continue
		set {_i} to 0
		while {_i} < {_n}:
			set {_raw} to {bcstruct::struct::%{_id}%::placement::%{_i}%}
			add 1 to {_i}
			if {_raw} is not set:
				continue
			set {_parts::*} to {_raw} split at "|"
			if size of {_parts::*} < 4:
				continue
			if {_parts::1} is not {_world}:
				continue
			set {_x} to {_parts::2} parsed as number
			set {_y} to {_parts::3} parsed as number
			set {_z} to {_parts::4} parsed as number
			if {_x} is not set:
				continue
			set {_dx} to {_x} - {_px}
			set {_dy} to {_y} - {_py}
			set {_dz} to {_z} - {_pz}
			set {_dist} to floor(sqrt(({_dx} * {_dx}) + ({_dy} * {_dy}) + ({_dz} * {_dz})))
			if {_bestDist} is -1:
				set {_bestDist} to {_dist}
			else if {_dist} < {_bestDist}:
				set {_bestDist} to {_dist}
	return "%{_bestDist}%"

placeholderapi placeholder with the prefix "bellcraft":
	set {_id} to the identifier

	if {_id} is "struct_count":
		if {bcstruct::count} is set:
			set the result to "%{bcstruct::count}%"
		else:
			set the result to "0"

	else if {_id} is "struct_nearest":
		set the result to bcstructNearestDisplay(player)

	else if {_id} is "struct_nearest_dist":
		set the result to bcstructNearestDist(player)

	else if {_id} is "struct_nearest_id":
		set the result to bcstructNearestId(player)

command /bcstruct [<text>] [<text>] [<text>]:
	permission: bellcraft.struct.admin
	permission message: {@prefix} &cNo permission (&fbellcraft.struct.admin&c).
	trigger:
		if arg-1 is not set:
			send "{@prefix} &7/bcstruct list | info <id> | register <id> <display> | save <id> [display] | place <id>" to player
			stop

		if arg-1 is "list":
			send "{@prefix} &7Registered structures:" to player
			loop {bcstruct::ids::*}:
				set {_sid} to loop-value
				set {_disp} to {bcstruct::struct::%{_sid}%::display}
				set {_n} to {bcstruct::struct::%{_sid}%::placement_count}
				set {_stub} to ""
				if {bcstruct::struct::%{_sid}%::stub} is true:
					set {_stub} to " &8[stub]"
				send "&8- &e%{_sid}% &7— &f%{_disp}% &8(placements: %{_n}%)%{_stub}%" to player
			stop

		if arg-1 is "info":
			if arg-2 is not set:
				send "{@prefix} &cUsage: /bcstruct info <id>" to player
				stop
			set {_sid} to arg-2
			if bcstructExists({_sid}) is false:
				send "{@prefix} &cUnknown id &e%{_sid}%" to player
				stop
			send "{@prefix} &e%{_sid}%" to player
			send "&7display: &f%{bcstruct::struct::%{_sid}%::display}%" to player
			send "&7schematic: &f%{bcstruct::struct::%{_sid}%::schematic}%" to player
			send "&7tags: &f%{bcstruct::struct::%{_sid}%::tags}%" to player
			send "&7trackable: &f%{bcstruct::struct::%{_sid}%::trackable}%" to player
			send "&7placements: &f%{bcstruct::struct::%{_sid}%::placement_count}%" to player
			set {_n} to {bcstruct::struct::%{_sid}%::placement_count}
			if {_n} is set:
				set {_i} to 0
				while {_i} < {_n}:
					send "&8  %{bcstruct::struct::%{_sid}%::placement::%{_i}%}%" to player
					add 1 to {_i}
			stop

		if arg-1 is "register":
			if arg-2 is not set:
				send "{@prefix} &cUsage: /bcstruct register <id> <display>" to player
				send "{@prefix} &7Multi-word display: use underscores, or run bc-struct register on the host." to player
				stop
			set {_sid} to arg-2
			set {_display} to arg-3
			if {_display} is not set:
				set {_display} to {_sid}
			replace all "_" with " " in {_display}
			bcstructBridge("register|%{_sid}%|%{_display}%")
			send "{@prefix} &aRegister requested for &e%{_sid}%&a (&f%{_display}%&a)." to player
			stop

		if arg-1 is "save":
			if arg-2 is not set:
				send "{@prefix} &cUsage: /bcstruct save <id> [display]" to player
				stop
			set {_sid} to arg-2
			set {_display} to arg-3
			if {_display} is not set:
				set {_display} to {_sid}
			replace all "_" with " " in {_display}
			make player execute command "//copy"
			wait 5 ticks
			make player execute command "//schem save -f %{_sid}%"
			wait 10 ticks
			bcstructBridge("save|%{_sid}%|%{_display}%")
			send "{@prefix} &aSave requested for &e%{_sid}%&a (FAWE selection required)." to player
			stop

		if arg-1 is "place":
			if arg-2 is not set:
				send "{@prefix} &cUsage: /bcstruct place <id>" to player
				stop
			set {_sid} to arg-2
			if bcstructExists({_sid}) is false:
				send "{@prefix} &cUnknown id &e%{_sid}%&c. Register or save first." to player
				stop
			make player execute command "//schem load %{_sid}%"
			wait 5 ticks
			make player execute command "//paste -a"
			wait 5 ticks
			set {_w} to "%world of player%"
			set {_x} to floor(x-coord of player)
			set {_y} to floor(y-coord of player)
			set {_z} to floor(z-coord of player)
			bcstructBridge("place|%{_sid}%|%{_w}%|%{_x}%|%{_y}%|%{_z}%")
			send "{@prefix} &aPlaced &e%{_sid}% &aat &f%{_x}% %{_y}% %{_z}%&a." to player
			stop

		send "{@prefix} &cUnknown subcommand. Use list|info|register|save|place" to player
